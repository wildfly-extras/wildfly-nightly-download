{
  "name": "wildfly-nightly-download",
  "version": "2.0.1",
  "description": "A GitHub Action to download a nightly build of WildFly or the nightly Maven Repository",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "npm run format:write && npm run package",
    "format:write": "prettier --no-error-on-unmatched-pattern --config ./.prettierrc.cjs --write \"{src,test}/**/*.js\" \".github/workflows/*.{yml,yaml}\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --config ./.prettierrc.cjs --check \"{src,test}/**/*.js\" \".github/workflows/*.{yml,yaml}\"",
    "package": "npx ncc build src/index.js -m -o dist/",
    "verify:dist": "npm run package && git diff --stat --exit-code -- dist/",
    "test": "node --test",
    "run:local": "INPUT_URI=${INPUT_URI:-https://ci.wildfly.org/guestAuth/repository/download/WF_Nightly/latest.lastSuccessful/wildfly-maven-repository.tar.gz} INPUT_PATH=${INPUT_PATH:-$(mktemp -d)} node src/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "author": "James R. Perkins",
  "license": "Apache-2.0",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.45.0",
    "prettier": "^3.9.8"
  }
}
